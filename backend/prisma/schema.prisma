generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  REJECTED
  ARCHIVED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum InventoryMovementReason {
  RESTOCK
  SALE
  RESERVATION
  RESERVATION_RELEASE
  CORRECTION
  RETURN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SellerOrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  MPESA
  MOCK
}

enum PaymentStatus {
  INITIATED
  PENDING
  INITIATION_UNKNOWN
  SUCCEEDED
  FAILED
  CANCELLED
  REVERSED
  REFUNDED
}

enum PaymentReviewStatus {
  OPEN
  IN_PROGRESS
  FULFILLMENT_APPROVED
  REFUND_REQUIRED
  REFUND_PENDING
  RESOLVED
  CLOSED
}

enum PaymentReviewReason {
  LATE_SUCCESS
  CANCELLED_ORDER_SUCCESS
  PAYMENT_REVERSAL
  CALLBACK_CONFLICT
  UNMATCHED_CALLBACK
  INVENTORY_UNAVAILABLE
  RECONCILIATION_REQUIRED
}

enum DarajaCallbackInboxStatus {
  RECEIVED
  MATCHED
  PROCESSED
  UNMATCHED
  CONFLICT
}

enum PaymentActionActorType {
  SYSTEM
  ADMIN
}

enum MerchantRefundStatus {
  INITIATED
  SUBMITTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

// USERS, ROLES AND SESSIONS

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                      RoleAssignment[]
  sellerProfile              SellerProfile?
  addresses                  Address[]
  carts                      Cart[]
  orders                     Order[]
  reviews                    Review[]
  wishlistItems              WishlistItem[]
  sessions                   Session[]
  reviewedSellers            SellerProfile[]       @relation("SellerReviewer")
  auditLogs                  AuditLog[]
  openedPaymentReviewCases   PaymentReviewCase[]   @relation("PaymentReviewOpenedBy")
  resolvedPaymentReviewCases PaymentReviewCase[]   @relation("PaymentReviewResolvedBy")
  paymentReviewEvents        PaymentReviewEvent[]
  merchantRefunds            MerchantRefund[]
  merchantRefundEvents       MerchantRefundEvent[]

  @@index([status, createdAt])
  @@map("users")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("role_assignments")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

// SELLERS AND STORES

model SellerProfile {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  businessName      String
  applicationStatus SellerApplicationStatus @default(PENDING)
  phone             String?
  email             String?
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewer User?  @relation("SellerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  store    Store?

  @@index([applicationStatus, createdAt])
  @@map("seller_profiles")
}

model Store {
  id              String      @id @default(cuid())
  sellerProfileId String      @unique
  name            String
  slug            String      @unique
  description     String?
  status          StoreStatus @default(INACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  products      Product[]
  sellerOrders  SellerOrder[]
  orderItems    OrderItem[]

  @@index([status, createdAt])
  @@map("stores")
}

// CATALOG

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, isActive])
  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  categoryId       String
  name             String
  slug             String
  description      String?
  price            Decimal       @db.Decimal(12, 2)
  currency         String        @default("KES") @db.VarChar(3)
  stockQuantity    Int           @default(0)
  reservedQuantity Int           @default(0)
  status           ProductStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category      Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  movements     InventoryMovement[]
  reservations  InventoryReservation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@unique([storeId, slug])
  @@index([categoryId, status])
  @@index([storeId, status])
  @@index([status, createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// INVENTORY

model InventoryMovement {
  id            String                  @id @default(cuid())
  productId     String
  quantityDelta Int
  reason        InventoryMovementReason
  referenceId   String?
  note          String?
  createdAt     DateTime                @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([reason, createdAt])
  @@map("inventory_movements")
}

model InventoryReservation {
  id          String            @id @default(cuid())
  orderItemId String            @unique
  productId   String
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

// CARTS AND WISHLISTS

model Cart {
  id             String    @id @default(cuid())
  userId         String?
  guestSessionId String?   @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
  @@index([userId, updatedAt])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ADDRESSES

model Address {
  id                   String   @id @default(cuid())
  userId               String
  recipientName        String
  phone                String
  county               String
  town                 String
  addressLine          String
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
  @@map("addresses")
}

model DeliveryRate {
  id        String   @id @default(cuid())
  county    String
  countyKey String
  town      String
  townKey   String
  fee       Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countyKey, townKey])
  @@index([isActive, countyKey])
  @@map("delivery_rates")
}

// ORDERS

model Order {
  id                    String      @id @default(cuid())
  userId                String
  addressId             String
  orderNumber           String      @unique
  status                OrderStatus @default(PENDING_PAYMENT)
  currency              String      @default("KES") @db.VarChar(3)
  subtotal              Decimal     @db.Decimal(12, 2)
  deliveryTotal         Decimal     @db.Decimal(12, 2)
  grandTotal            Decimal     @db.Decimal(12, 2)
  idempotencyKey        String
  deliveryRecipientName String
  deliveryPhone         String
  deliveryCounty        String
  deliveryTown          String
  deliveryAddressLine   String
  deliveryInstructions  String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  address            Address             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  sellerOrders       SellerOrder[]
  payments           Payment[]
  paymentReviewCases PaymentReviewCase[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  storeId             String
  productNameSnapshot String
  unitPrice           Decimal  @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  store            Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  reservation      InventoryReservation?
  sellerOrderItems SellerOrderItem[]     @relation("OrderItemSellerOrder")

  @@unique([id, orderId, storeId], map: "order_items_id_order_store_key")
  @@index([orderId])
  @@index([productId])
  @@index([storeId])
  @@map("order_items")
}

model SellerOrder {
  id        String            @id @default(cuid())
  orderId   String
  storeId   String
  status    SellerOrderStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  order Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  store Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items SellerOrderItem[] @relation("SellerOrderItems")

  @@unique([orderId, storeId])
  @@unique([id, orderId, storeId], map: "seller_orders_id_order_store_key")
  @@index([storeId, status, createdAt])
  @@map("seller_orders")
}

model SellerOrderItem {
  id            String @id @default(cuid())
  sellerOrderId String
  orderItemId   String @unique
  orderId       String
  storeId       String

  sellerOrder SellerOrder @relation("SellerOrderItems", fields: [sellerOrderId, orderId, storeId], references: [id, orderId, storeId], onDelete: Restrict)
  orderItem   OrderItem   @relation("OrderItemSellerOrder", fields: [orderItemId, orderId, storeId], references: [id, orderId, storeId], onDelete: Restrict)

  @@index([orderId, storeId])
  @@map("seller_order_items")
}

// PAYMENTS

model Payment {
  id                       String          @id @default(cuid())
  orderId                  String
  provider                 PaymentProvider
  status                   PaymentStatus   @default(INITIATED)
  amount                   Decimal         @db.Decimal(12, 2)
  currency                 String          @default("KES") @db.VarChar(3)
  phoneNumber              String?
  merchantRequestId        String?
  checkoutRequestId        String?         @unique
  providerTransactionId    String?         @unique
  failureCode              String?
  failureMessage           String?
  initiationIdempotencyKey String?         @unique(map: "payments_initiationIdempotencyKey_key")
  dispatchStartedAt        DateTime?
  providerResponseAt       DateTime?
  providerResultCode       String?
  initiatedAt              DateTime        @default(now())
  completedAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events               PaymentEvent[]
  callbackInboxEntries DarajaCallbackInbox[]
  reviewCases          PaymentReviewCase[]
  refunds              MerchantRefund[]

  @@index([orderId, status])
  @@index([provider, status, createdAt])
  @@index([merchantRequestId])
  @@map("payments")
}

model PaymentEvent {
  id             String    @id @default(cuid())
  paymentId      String
  eventKey       String    @unique
  eventType      String
  payloadSummary Json
  processedAt    DateTime?
  receivedAt     DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, receivedAt])
  @@index([processedAt])
  @@map("payment_events")
}

model DarajaCallbackInbox {
  id                    String                    @id @default(cuid())
  paymentId             String?
  callbackIdentity      String                    @unique(map: "daraja_callback_inbox_callbackIdentity_key") @db.Char(64)
  callbackFingerprint   String                    @db.Char(64)
  fingerprintKeyVersion Int
  checkoutRequestId     String?
  merchantRequestId     String?
  resultCode            String?
  providerTransactionId String?
  status                DarajaCallbackInboxStatus @default(RECEIVED)
  sanitizedPayload      Json
  receivedAt            DateTime                  @default(now())
  processedAt           DateTime?

  payment  Payment?                    @relation(fields: [paymentId], references: [id], onDelete: SetNull, map: "daraja_callback_inbox_paymentId_fkey")
  aliases  DarajaCallbackCorrelation[]
  evidence PaymentReviewEvent[]

  @@index([checkoutRequestId], map: "daraja_callback_inbox_checkoutRequestId_idx")
  @@index([merchantRequestId], map: "daraja_callback_inbox_merchantRequestId_idx")
  @@index([paymentId, receivedAt], map: "daraja_callback_inbox_paymentId_receivedAt_idx")
  @@index([status, receivedAt], map: "daraja_callback_inbox_status_receivedAt_idx")
  @@map("daraja_callback_inbox")
}

model DarajaCallbackCorrelation {
  id                 String   @id @default(cuid())
  callbackInboxId    String
  identifierType     String
  identifierIdentity String   @db.Char(64)
  createdAt          DateTime @default(now())

  callback DarajaCallbackInbox @relation(fields: [callbackInboxId], references: [id], onDelete: Restrict, map: "daraja_callback_correlations_inbox_fkey")

  @@unique([callbackInboxId, identifierType], map: "daraja_callback_correlations_inbox_type_key")
  @@index([identifierType, identifierIdentity], map: "daraja_callback_correlations_type_identity_idx")
  @@map("daraja_callback_correlations")
}

model PaymentReviewCase {
  id           String              @id @default(cuid())
  openingKey   String              @unique(map: "payment_review_cases_openingKey_key") @db.Char(64)
  orderId      String
  paymentId    String?
  reason       PaymentReviewReason
  status       PaymentReviewStatus @default(OPEN)
  summary      String
  openedById   String?
  resolvedById String?
  resolution   String?
  openedAt     DateTime            @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "payment_review_cases_order_fkey")
  payment    Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull, map: "payment_review_cases_payment_fkey")
  openedBy   User?                @relation("PaymentReviewOpenedBy", fields: [openedById], references: [id], onDelete: SetNull, map: "payment_review_cases_opened_by_fkey")
  resolvedBy User?                @relation("PaymentReviewResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, map: "payment_review_cases_resolved_by_fkey")
  events     PaymentReviewEvent[]
  refunds    MerchantRefund[]

  @@index([status, openedAt], map: "payment_review_cases_status_openedAt_idx")
  @@index([orderId, openedAt], map: "payment_review_cases_orderId_openedAt_idx")
  @@index([paymentId, openedAt], map: "payment_review_cases_paymentId_openedAt_idx")
  @@map("payment_review_cases")
}

model PaymentReviewEvent {
  id              String                 @id @default(cuid())
  caseId          String
  actorType       PaymentActionActorType
  actorId         String?
  callbackInboxId String?
  action          String
  details         Json
  createdAt       DateTime               @default(now())

  reviewCase    PaymentReviewCase    @relation(fields: [caseId], references: [id], onDelete: Restrict, map: "payment_review_events_case_fkey")
  actor         User?                @relation(fields: [actorId], references: [id], onDelete: Restrict, map: "payment_review_events_actor_fkey")
  callbackInbox DarajaCallbackInbox? @relation(fields: [callbackInboxId], references: [id], onDelete: Restrict, map: "payment_review_events_callback_fkey")

  @@index([caseId, createdAt], map: "payment_review_events_caseId_createdAt_idx")
  @@index([actorId, createdAt], map: "payment_review_events_actorId_createdAt_idx")
  @@index([callbackInboxId], map: "payment_review_events_callbackInboxId_idx")
  @@map("payment_review_events")
}

model MerchantRefund {
  id                 String                 @id @default(cuid())
  paymentId          String
  reviewCaseId       String?
  idempotencyKey     String                 @unique
  actorType          PaymentActionActorType
  actorId            String?
  status             MerchantRefundStatus   @default(INITIATED)
  amount             Decimal                @db.Decimal(12, 2)
  currency           String                 @default("KES") @db.VarChar(3)
  reason             String
  providerRefundId   String?                @unique
  providerRequestId  String?
  failureCode        String?
  failureMessage     String?
  dispatchStartedAt  DateTime?
  providerResponseAt DateTime?
  initiatedAt        DateTime               @default(now())
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  payment    Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "merchant_refunds_payment_fkey")
  reviewCase PaymentReviewCase?    @relation(fields: [reviewCaseId], references: [id], onDelete: SetNull, map: "merchant_refunds_review_case_fkey")
  actor      User?                 @relation(fields: [actorId], references: [id], onDelete: Restrict, map: "merchant_refunds_actor_fkey")
  events     MerchantRefundEvent[]

  @@index([paymentId, status, createdAt], map: "merchant_refunds_paymentId_status_createdAt_idx")
  @@index([reviewCaseId], map: "merchant_refunds_reviewCaseId_idx")
  @@index([status, createdAt], map: "merchant_refunds_status_createdAt_idx")
  @@index([providerRequestId], map: "merchant_refunds_providerRequestId_idx")
  @@map("merchant_refunds")
}

model MerchantRefundEvent {
  id        String                 @id @default(cuid())
  refundId  String
  actorType PaymentActionActorType
  actorId   String?
  action    String
  details   Json
  createdAt DateTime               @default(now())

  refund MerchantRefund @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "merchant_refund_events_refund_fkey")
  actor  User?          @relation(fields: [actorId], references: [id], onDelete: Restrict, map: "merchant_refund_events_actor_fkey")

  @@index([refundId, createdAt], map: "merchant_refund_events_refundId_createdAt_idx")
  @@index([actorId, createdAt], map: "merchant_refund_events_actorId_createdAt_idx")
  @@map("merchant_refund_events")
}

// REVIEWS

model Review {
  id          String       @id @default(cuid())
  userId      String
  productId   String
  rating      Int
  comment     String?
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

// AUDIT LOGS

model AuditLog {
  id           String       @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  outcome      AuditOutcome
  requestId    String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([outcome, createdAt])
  @@map("audit_logs")
}

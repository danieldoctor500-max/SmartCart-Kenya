NODE_ENV=development
APP_NAME=SmartCart Kenya

FRONTEND_PORT=5173
BACKEND_PORT=3000

POSTGRES_DB=smartcart_kenya
POSTGRES_USER=smartcart_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

DATABASE_URL=postgresql://smartcart_app:change_me_local_only@localhost:5433/smartcart_kenya?schema=public
# Optional; use only for controlled Prisma CLI operations such as production migrations.

SESSION_COOKIE_NAME=smartcart_session

VITE_API_BASE_URL=/api/v1

# Configure these later; never expose private keys through VITE_ variables.

# Safaricom Daraja sandbox configuration will be added during payment integration.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

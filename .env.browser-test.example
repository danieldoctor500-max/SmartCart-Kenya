# Copy to .env.browser-test and configure a dedicated local PostgreSQL role.
# The database must be created manually and owned by BROWSER_TEST_DATABASE_USER.
NODE_ENV=test
DATABASE_URL=postgresql://smartcart_browser_test:URL_ENCODED_LOCAL_SECRET@localhost:5435/smartcart_kenya_browser_test
BROWSER_TEST_DATABASE_USER=smartcart_browser_test
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=smartcart_browser_test_session
